RewriteEngine On
RewriteBase /

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpe?g|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# Keep account.php accessible because /account is an existing folder.
RewriteRule ^account\.php$ - [L]
RewriteRule ^account/?$ account.php [L,QSA]

RewriteRule ^product/([a-zA-Z0-9-]+)$ product.php?handle=$1 [L,QSA]

# Serve /menu from menu.php, /account/profile from account/profile.php, etc.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]
